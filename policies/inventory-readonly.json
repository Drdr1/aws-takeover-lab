{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InventoryReadsMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:ListAllMyBuckets",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "iam:List*",
        "iam:GetRole",
        "secretsmanager:ListSecrets",
        "cloudtrail:DescribeTrails"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadData",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "s3:GetObject",
        "kms:Decrypt",
        "ssm:GetParameter*",
        "rds:DownloadDBLogFilePortion"
      ],
      "Resource": "*"
    }
  ]
}
