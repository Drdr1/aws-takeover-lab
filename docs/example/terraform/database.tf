  storage_encrypted         = false
  backup_retention_period   = 1
  deletion_protection       = false
  multi_az                  = false
  skip_final_snapshot       = false
  final_snapshot_identifier = "los-db-final"
  tags = {
    Owner = "previous-engineer"
  }

  lifecycle {
    ignore_changes = [password]
  }
}
