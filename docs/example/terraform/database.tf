resource "aws_db_subnet_group" "los_db_subnets" {
  name        = "los-db-subnets"
  description = "LOS database subnets"
  subnet_ids  = [aws_subnet.los_private_a.id, aws_subnet.los_private_b.id]
}

# TKO-003 (high): Database has a public endpoint
# TKO-004 (high): Database storage and snapshots are not encrypted
# TKO-005 (medium): Only 1 day(s) of automated backups
# TKO-006 (medium): Deletion protection is off
# Reproduced exactly as found. The fix is a separate, approved change.
resource "aws_db_instance" "los_db" {
  identifier                = "los-db"
  engine                    = "postgres"
  engine_version            = "16.3"
  instance_class            = "db.t3.medium"
  allocated_storage         = 100
  username                  = "losadmin"
  db_subnet_group_name      = aws_db_subnet_group.los_db_subnets.name
  vpc_security_group_ids    = [aws_security_group.los_db.id]
